# Copia este archivo como .env y rellena tus valores.
# .env está en .gitignore: tus claves NO se suben a GitHub.

# --- Telegram (alertas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Servidor del dashboard ---
# 127.0.0.1 = solo tu ordenador (recomendado). 0.0.0.0 = toda tu red local.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# --- Trading automático con dinero real (Selenium) ---
# Desactivado por defecto. Ponlo en true solo si entiendes el riesgo.
ENABLE_LIVE_TRADING=false

# --- Datos simulados de Binomo ---
# Los datos simulados son ALEATORIOS. Nunca se usan para señales ni alertas.
ALLOW_SIMULATED_DATA=false
